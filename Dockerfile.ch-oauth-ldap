# ch-oauth-ldap standalone LDAP server image. Built by
# scripts/build-ch-oauth-ldap-image.sh (manual, multi-arch) or
# .github/workflows/build-ch-oauth-ldap.yml (push-to-main, multi-arch): both
# cross-compile a statically-linked binary into a private temporary build
# context alongside a copy of this Dockerfile, then `docker build` from that
# context with legacy DOCKER_BUILDKIT=0 (some sandboxed docker proxies refuse
# the privileged container buildkit needs for cross-arch) — never against the
# repository checkout itself, so no `ch-oauth-ldap` binary is ever produced
# in the repo root.
#
# alpine:3.24 is pinned (not "latest") to match this repo's existing
# integration-runtime convention; see integration/clickhouse/README.md.
FROM alpine:3.24

RUN apk --no-cache add ca-certificates

# The Deployment's preStop hook (helm/ch-oauth-ldap) shells out to
# /bin/sleep for a best-effort endpoint-withdrawal delay before SIGTERM
# closes the LDAP listener; fail the image build loudly if a future base
# image ever drops it rather than fail silently at pod termination.
RUN test -x /bin/sleep

# The binary is compiled OUTSIDE this Dockerfile (see the build script/
# workflow above) and supplied by the build context — never built in-image.
COPY ch-oauth-ldap /bin/ch-oauth-ldap

LABEL org.opencontainers.image.source="https://github.com/Altinity/altinity-oauth-helper"

# Matches the chart's pinned pod security context (runAsUser/runAsGroup
# 65532, runAsNonRoot: true) — see helm/ch-oauth-ldap/templates/deployment.yaml.
USER 65532:65532

# The LDAP listener is fixed to :3389 (never a privileged port, so no
# NET_BIND_SERVICE capability is needed); the chart's Service maps
# ClusterIP port 389 -> container port 3389.
EXPOSE 3389

ENTRYPOINT ["/bin/ch-oauth-ldap"]
