# Defaults the compose stack reads from .env. up.sh auto-materialises
# this file on first run; you can also `cp .env.example .env` and edit
# by hand.

# The Grafana image is built from source on first up.sh — no secret is
# strictly required. We pin the upstream plugin tag here so it's easy
# to swap without editing the Dockerfile.
ALTINITY_PLUGIN_TAG=v3.4.11
