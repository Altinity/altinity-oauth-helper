# Defaults the compose stack reads from .env. up.sh auto-materialises
# this file with a fresh SUPERSET_SECRET_KEY on first run; you can also
# `cp .env.example .env` and edit by hand.

# Required: 32+ bytes of random entropy for Flask session cookie signing.
# Generated by up.sh; placeholder must be overwritten before launching.
SUPERSET_SECRET_KEY=REPLACE_ME_openssl_rand_base64_42

# Optional: emergency direct-login admin (everyone else logs in via Dex).
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@superset.local
