# Example secrets file. Copy to superset-secrets.yaml (which IS gitignored
# at the deploy root) and fill in real values. The deploy command picks it
# up with `-f superset-secrets.yaml`.
#
#   SUPERSET_SECRET_KEY   openssl rand -base64 42
#   AUTH0_CLIENT_ID       From the Auth0 "Superset (otel demo)" application
#   AUTH0_CLIENT_SECRET   ↳ Settings tab
#
# These three are mounted into the supersetNode pod as env vars (via a
# k8s Secret the chart generates from `extraSecretEnv`). They flow into:
#   - Flask's app.config.SECRET_KEY  (session cookie signing)
#   - OAUTH_PROVIDERS[0].remote_app.client_id / client_secret  (in
#     configOverrides.10_oauth_auth0)

extraSecretEnv:
  SUPERSET_SECRET_KEY: "REPLACE_WITH_openssl_rand_base64_42"
  AUTH0_CLIENT_ID: "REPLACE_WITH_AUTH0_CLIENT_ID"
  AUTH0_CLIENT_SECRET: "REPLACE_WITH_AUTH0_CLIENT_SECRET"
